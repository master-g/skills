---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { parts, chapters, getPartTitle, getPartEpigraph, getChapterTitle, getChapterDescription } from '../../book.config';
import { t } from '../../i18n/ui';

const lang = 'zh' as const;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const firstSlug = chapters[0]?.slug;
const githubUrl = t(lang, 'githubUrl');
---

<BaseLayout title={t(lang, 'siteTitle')} description={t(lang, 'heroDescription')} lang={lang}>
  <Header />

  <main class="max-w-4xl mx-auto px-4 md:px-8 py-12 md:py-20">
    <div class="text-center mb-20">
      <h1 class="text-3xl md:text-4xl font-bold font-[var(--font-serif)] text-[var(--color-charcoal)] dark:text-[var(--color-cream)] mb-6 leading-tight">
        {t(lang, 'siteTitle')}
      </h1>
      <p class="text-lg text-[var(--color-secondary)] dark:text-[var(--color-muted)] max-w-2xl mx-auto leading-relaxed mb-6">
        {t(lang, 'siteTagline')}
      </p>
      {firstSlug && (
        <a
          href={`${base}zh/${firstSlug}/`}
          class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-terracotta)] text-white font-medium rounded-lg hover:opacity-90 transition-opacity"
        >
          {t(lang, 'startReading')}
        </a>
      )}
    </div>

    <section class="mb-20">
      <h2 class="text-2xl font-bold font-[var(--font-serif)] text-[var(--color-charcoal)] dark:text-[var(--color-cream)] mb-8">
        {t(lang, 'tableOfContents')}
      </h2>
      {parts.map((part) => {
        const partChapters = chapters.filter(c => part.chapters.includes(c.number));
        return (
          <div class="mb-10">
            <div class="flex items-baseline gap-3 mb-1">
              <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-terracotta)]">{t(lang, 'part')} {part.number}</span>
              <h3 class="text-lg font-bold text-[var(--color-charcoal)] dark:text-[var(--color-cream)] font-[var(--font-serif)]">{getPartTitle(part, lang)}</h3>
            </div>
            <p class="text-sm italic text-[var(--color-muted)] mb-4">{getPartEpigraph(part, lang)}</p>
            <div class="space-y-2">
              {partChapters.map((ch) => (
                <a
                  href={`${base}zh/${ch.slug}/`}
                  class="group flex items-start gap-3 p-3 -mx-3 rounded-lg hover:bg-[var(--color-beige)] dark:hover:bg-[var(--color-dark-surface)] transition-colors"
                >
                  <span class="text-sm font-mono text-[var(--color-muted)] mt-0.5 w-6 shrink-0 text-right">{ch.number}</span>
                  <div>
                    <span class="text-[var(--color-charcoal)] dark:text-[var(--color-cream)] group-hover:text-[var(--color-terracotta)] font-medium transition-colors">
                      {getChapterTitle(ch, lang)}
                    </span>
                    <p class="text-sm text-[var(--color-muted)] mt-0.5">{getChapterDescription(ch, lang)}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
      {parts.length === 0 && (
        <p class="text-[var(--color-muted)]">尚无章节。分析完成后请填写 <code>src/book.config.ts</code>。</p>
      )}
    </section>

    <footer class="text-center text-sm text-[var(--color-muted)] border-t border-[var(--color-border)] dark:border-[#333] pt-8 pb-12">
      <p>{t(lang, 'disclaimer')}</p>
      {githubUrl && (
        <p class="mt-2">
          <a href={githubUrl} class="text-[var(--color-terracotta)] hover:underline">GitHub</a>
        </p>
      )}
    </footer>
  </main>
</BaseLayout>
